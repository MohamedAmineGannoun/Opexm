14:["$","$1","c",{"children":[["$","$L24",null,{"dict":{"meta":{"title":"Opexm — Agence de développement web & mobile","description":"Opexm conçoit et développe des applications web et mobiles sur mesure : sites vitrines, e-commerce, plateformes SaaS, apps iOS & Android."},"header":{"services":"Services","works":"Réalisations","contact":"Contact","startProject":"Démarrer un projet","openMenu":"Ouvrir le menu","closeMenu":"Fermer le menu","switchLanguage":"Changer de langue"},"footer":{"tagline":"Agence de développement web et mobile. Nous transformons vos idées en produits digitaux qui durent.","services":"Services","navigation":"Navigation","contact":"Contact","madeWith":"Fait avec Next.js, Tailwind CSS et beaucoup de café.","rights":"Tous droits réservés.","webDev":"Développement web","mobileApps":"Applications mobiles","uiUx":"UI/UX Design","home":"Accueil"},"shared":{"more":"En savoir plus","allWorks":"Voir toutes les réalisations","chosen":"Le plus choisi","choosePlan":"Choisir cette offre","faq":"FAQ"},"home":{"badge":"Agence web & mobile · Tunisie","heroTitleStart":"Nous créons des","heroHighlight":"applications","heroTitleEnd":"que vos utilisateurs adorent","heroText":"Opexm conçoit et développe des sites web et des applications mobiles sur mesure. Design soigné, code moderne, livraisons par sprints : votre projet avance, vous gardez le contrôle.","heroCta":"Démarrer votre projet","heroSecondary":"Voir nos réalisations","servicesEta":"Nos services","servicesTitle":"Tout ce qu'il faut pour réussir en ligne","servicesText":"De la première maquette à la mise en production, nous couvrons l'ensemble du cycle de vie de votre produit digital.","methodEta":"Méthode","methodTitle":"Un processus clair, sans surprise","methodText":"Vous savez toujours où en est votre projet, ce qui arrive ensuite, et combien ça coûte.","worksEta":"Réalisations","worksTitle":"Des projets qui font la différence","worksText":"Quelques exemples de produits que nous avons conçus, développés et lancés avec nos clients.","quotesEta":"Témoignages","quotesTitle":"Ils nous ont fait confiance","stackEta":"Stack technique","stackTitle":"Des technologies modernes et éprouvées","pricingEta":"Tarifs","pricingTitle":"Des offres lisibles, adaptées à votre stade","pricingText":"Un budget cadré dès le départ. Pas de coûts cachés, pas de mauvaises surprises.","faqTitle":"Vos questions, nos réponses","contactTitle":"Un projet en tête ? Parlons-en.","contactText":"Réponse sous 24 h ouvrées, sans engagement.","contactCity":"Monastir, Tunisie","contactCta":"Lancer la conversation","ctaTitle":"Prêt à faire décoller votre projet ?","ctaText":"Racontez-nous votre idée. Nous revenons vers vous avec un plan d'action et une estimation claire, gratuitement.","ctaButton":"Demander un devis gratuit","stripMessage":"Un projet à garder en tête ?","stripButton":"Discutons-en"},"servicesPage":{"title":"Nos services","intro":"Quatre expertises complémentaires pour construire des produits digitaux complets, du design à l'infrastructure.","techEta":"Technologies","techTitle":"Notre boîte à outils","techText":"Nous choisissons la technologie adaptée à votre projet, pas l'inverse.","ctaTitle":"Besoin d'un service en particulier ?","ctaText":"Décrivez votre besoin, nous vous dirons honnêtement si nous sommes le bon partenaire — et sinon, qui contacter.","ctaButton":"Discuter de ce service"},"worksPage":{"title":"Nos réalisations","intro":"Des produits digitaux conçus avec nos clients, mesurés à l'impact réel qu'ils ont généré.","clientsEta":"Clients","clientsTitle":"Ce qu'ils en disent","ctaTitle":"Votre projet ici ?","ctaText":"Chaque case de cette grille a commencé par une conversation. La vôtre peut être la prochaine."},"contactPage":{"title":"Parlons de votre projet","intro":"Décrivez-nous votre idée en quelques lignes. Nous revenons vers vous avec une première analyse et un rendez-vous, gratuitement.","form":{"name":"Nom complet *","namePlaceholder":"Marie Dupont","email":"Email *","emailPlaceholder":"marie@entreprise.com","company":"Société","companyPlaceholder":"Entreprise SAS","projectType":"Type de projet *","budget":"Budget envisagé","message":"Votre projet en quelques mots *","messagePlaceholder":"Ex. : nous voulons une app mobile pour que nos clients réservent nos prestations en ligne...","submit":"Envoyer ma demande","sending":"Envoi en cours...","privacy":"Vos données restent confidentielles et ne sont jamais partagées."},"success":{"title":"Message envoyé !","text":"Merci pour votre message. Notre équipe vous recontacte sous 24 h ouvrées pour planifier un premier échange.","again":"Envoyer un autre message"},"aside":{"title":"Contact direct","email":"Email","phone":"Téléphone","address":"Adresse","hours":"Horaires","freeTitle":"⚡ Premier échange gratuit","freeText":"30 minutes par téléphone ou visio pour cerner votre besoin. Vous repartez avec un avis honnête, même si nous ne travaillons pas ensemble."}},"data":{"services":[{"title":"Développement web","tagline":"Sites vitrines, e-commerce et plateformes SaaS","description":"Des applications web rapides, accessibles et scalables. Nous concevons des expériences qui chargent vite, référencent bien et convertissent vos visiteurs en clients.","deliverables":["Site vitrine ou corporate","Boutique e-commerce","Application web & SaaS","Migration et refonte"]},{"title":"Applications mobiles","tagline":"iOS et Android, natif ou cross-platform","description":"Des applications mobiles pensées pour l'usage réel : fluides, élégantes et stables. De l'idée au store, nous accompagnons chaque étape du cycle de vie de votre app.","deliverables":["Apps iOS & Android","MVP startup","Applications internes","Publication sur les stores"]},{"title":"UI/UX Design","tagline":"Interfaces qui plaisent et fonctionnent","description":"Un bon produit commence par une bonne expérience. Nous dessinons des interfaces claires, testées avec de vrais utilisateurs, et livrons des design systems réutilisables.","deliverables":["Design system","Maquettes Figma","Audit UX","Prototypes interactifs"]},{"title":"Backend & Cloud","tagline":"APIs robustes et infrastructures fiables","description":"La partie immergée de l'iceberg : APIs sécurisées, bases de données bien modélisées, CI/CD et hébergement cloud. Tout ce qu'il faut pour grandir sans douleur.","deliverables":["API REST & GraphQL","Architecture cloud","CI/CD & DevOps","Monitoring & sécurité"]}],"steps":[{"title":"Découverte","description":"Un premier échange pour comprendre votre métier, vos utilisateurs et vos contraintes. Sans jargon, sans engagement."},{"title":"Conception","description":"Wireframes, maquettes et stack technique validés ensemble. Vous savez exactement ce qui sera livré, et à quel prix."},{"title":"Développement","description":"Sprints de deux semaines avec démos régulières. Vous voyez le produit avancer et pouvez ajuster le tir en continu."},{"title":"Lancement & suivi","description":"Mise en production, formation de vos équipes et maintenance. Nous restons à vos côtés après la mise en ligne."}],"testimonials":[{"quote":"Opexm a compris notre métier en une semaine. L'app est sortie dans les délais, avec un niveau de finition qu'on n'avait jamais vu chez un prestataire.","author":"Sarah Marchetti","role":"CEO, PayFlow"},{"quote":"La refonte de notre e-commerce a doublé notre panier moyen en trois mois. Communication claire, itérations rapides, zéro surprise sur la facture.","author":"Karim Belkacem","role":"Fondateur, Marché Libre"},{"quote":"Ils ont remplacé un outil Excel monstrueux par une plateforme que toute l'équipe a adoptée en deux jours. Du travail d'orfèvre.","author":"Claire Dubois","role":"Directrice des opérations, MediTrack"}],"pricing":[{"name":"Site vitrine","price":"à partir de 2 900 €","description":"Pour exister en ligne avec un site rapide et soigné.","features":["Design sur mesure (maquette incluse)","Jusqu'à 8 pages","SEO technique de base","Formulaire de contact","Mise en ligne & formation","3 mois de maintenance offerte"]},{"name":"Pack App","price":"à partir de 14 900 €","description":"Pour lancer votre application mobile ou votre SaaS.","features":["Étude UX & maquettes","App iOS + Android ou web app","Backend & API inclus","Publication sur les stores","Analytics & suivi","6 mois de maintenance offerte"]},{"name":"Sur mesure","price":"sur devis","description":"Pour les projets ambitieux avec des exigences spécifiques.","features":["Cadrage & ateliers de conception","Architecture dédiée","Intégrations existantes","Équipe dédiée au projet","SLA & support prioritaire","Évolution continue"]}],"faq":[{"question":"Combien coûte un site ou une application ?","answer":"Un site vitrine démarre autour de 2 900 €, une application mobile au-delà de 14 900 €. Chaque projet étant unique, nous établissons un devis détaillé et sans surprise après un premier échange gratuit."},{"question":"Quels sont vos délais ?","answer":"Comptez 3 à 6 semaines pour un site vitrine, et 2 à 4 mois pour une application mobile ou une plateforme web. Nous livrons par sprints, vous voyez le produit dès les premières semaines."},{"question":"Travaillez-vous avec des clients hors de Paris ?","answer":"Oui, nous travaillons avec des clients dans toute la France et en Europe. Nos processus distancés (démos hebdomadaires, outil de gestion partagé) rendent la collaboration fluide, où que vous soyez."},{"question":"Que se passe-t-il après la mise en ligne ?","answer":"Chaque projet inclut une période de garantie. Ensuite, nos offres de maintenance couvrent les mises à jour, la sécurité, les sauvegardes et les évolutions. Vous restez maître de votre produit."},{"question":"Code-sur-mesure ou no-code ?","answer":"Nous développons sur mesure avec des technologies modernes (Next.js, React Native...). Cela garantit la performance, la propriété du code et l'absence de dépendance à une plateforme propriétaire. Pour les budgets serrés, nous savons aussi recommander une solution no-code adaptée."}],"projectTypes":["Site web vitrine","E-commerce","Application mobile","Plateforme web / SaaS","Refonte / migration","Autre"],"budgets":["< 5 000 €","5 000 – 15 000 €","15 000 – 50 000 €","> 50 000 €","Je ne sais pas encore"],"projectsText":[{"category":"Fintech · App mobile","description":"Application mobile de paiement entre particuliers avec authentification biométrique et suivi en temps réel des transactions.","result":"120 000 téléchargements la première année"},{"category":"E-commerce · Web","description":"Plateforme e-commerce de produits locaux avec moteur de recherche instantané, panier optimisé et tableau de bord vendeur.","result":"+38 % de conversion après refonte"},{"category":"Santé · SaaS","description":"SaaS de suivi de stocks pour pharmacies : alertes de péremption, commandes automatiques et conformité des données de santé.","result":"97 % de réduction des ruptures de stock"},{"category":"Mobilité · App hybride","description":"App de covoiturage dédiée aux campus universitaires : trajets quotidiens, réservation de places et messagerie intégrée.","result":"45 000 trajets organisés en 8 mois"},{"category":"Artisanat · Vitrine","description":"Site vitrine d'un atelier de céramique avec galerie immersive, prise de rendez-vous en ligne et vente de pièces uniques.","result":"Book de commandes plein pendant 6 mois"},{"category":"Logistique · Plateforme B2B","description":"Plateforme web de gestion de flotte de véhicules : suivi GPS temps réel, maintenance prédictive et rapports automatisés.","result":"-30 % de coûts de maintenance flotte"}],"stats":[{"value":"30+","label":"Projets livrés"},{"value":"12","label":"Années d'expérience"},{"value":"98 %","label":"Clients satisfaits"},{"value":"8","label":"Experts passionnés"}]}}}],["$L25"],"$L26"]}]
