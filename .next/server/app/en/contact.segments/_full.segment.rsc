b:["$","$L23",null,{"dict":{"meta":{"title":"Opexm — Web & Mobile Development Agency","description":"Opexm designs and builds custom web and mobile applications: showcase sites, e-commerce, SaaS platforms, iOS & Android apps."},"header":{"services":"Services","works":"Our work","contact":"Contact","startProject":"Start a project","openMenu":"Open menu","closeMenu":"Close menu","switchLanguage":"Switch language"},"footer":{"tagline":"Web and mobile development agency. We turn your ideas into digital products that last.","services":"Services","navigation":"Navigation","contact":"Contact","madeWith":"Built with Next.js, Tailwind CSS and a lot of coffee.","rights":"All rights reserved.","webDev":"Web development","mobileApps":"Mobile apps","uiUx":"UI/UX Design","home":"Home"},"shared":{"more":"Learn more","allWorks":"See all our work","chosen":"Most popular","choosePlan":"Choose this plan","faq":"FAQ"},"home":{"badge":"Web & Mobile Agency · Tunisia","heroTitleStart":"We build","heroHighlight":"applications","heroTitleEnd":"your users will love","heroText":"Opexm designs and develops custom websites and mobile apps. Polished design, modern code, sprint-based delivery: your project moves forward, you stay in control.","heroCta":"Start your project","heroSecondary":"See our work","servicesEta":"Our services","servicesTitle":"Everything you need to succeed online","servicesText":"From the first mockup to production, we cover the entire life cycle of your digital product.","methodEta":"Method","methodTitle":"A clear process, no surprises","methodText":"You always know where your project stands, what comes next, and how much it costs.","worksEta":"Our work","worksTitle":"Projects that make a difference","worksText":"A few examples of products we have designed, built and launched with our clients.","quotesEta":"Testimonials","quotesTitle":"They trusted us","stackEta":"Tech stack","stackTitle":"Modern, proven technologies","pricingEta":"Pricing","pricingTitle":"Clear offers, built for your stage","pricingText":"A budget set from day one. No hidden costs, no nasty surprises.","faqTitle":"Your questions, answered","contactTitle":"Got a project in mind? Let's talk.","contactText":"Reply within 24 business hours, no strings attached.","contactCity":"Monastir, Tunisia","contactCta":"Start the conversation","ctaTitle":"Ready to launch your project?","ctaText":"Tell us about your idea. We'll come back with an action plan and a clear estimate, for free.","ctaButton":"Request a free quote","stripMessage":"A project to keep in mind?","stripButton":"Let's discuss"},"servicesPage":{"title":"Our services","intro":"Four complementary areas of expertise to build complete digital products, from design to infrastructure.","techEta":"Technologies","techTitle":"Our toolbox","techText":"We pick the technology that fits your project, not the other way around.","ctaTitle":"Need a specific service?","ctaText":"Describe your need, and we'll honestly tell you whether we're the right partner — and if not, who to contact.","ctaButton":"Discuss this service"},"worksPage":{"title":"Our work","intro":"Digital products built with our clients, measured by the real impact they created.","clientsEta":"Clients","clientsTitle":"What they say","ctaTitle":"Your project here?","ctaText":"Every item in this grid started with a conversation. Yours could be next."},"contactPage":{"title":"Let's talk about your project","intro":"Describe your idea in a few lines. We'll get back to you with an initial analysis and a meeting, free of charge.","form":{"name":"Full name *","namePlaceholder":"Jane Smith","email":"Email *","emailPlaceholder":"jane@company.com","company":"Company","companyPlaceholder":"Company Ltd","projectType":"Project type *","budget":"Estimated budget","message":"Your project in a few words *","messagePlaceholder":"e.g. we want a mobile app so our clients can book our services online...","submit":"Send my request","sending":"Sending...","privacy":"Your data stays confidential and is never shared."},"success":{"title":"Message sent!","text":"Thank you for your message. Our team will get back to you within 24 business hours to schedule an initial call.","again":"Send another message"},"aside":{"title":"Direct contact","email":"Email","phone":"Phone","address":"Address","hours":"Hours","freeTitle":"⚡ Free first call","freeText":"30 minutes by phone or video to understand your need. You'll leave with an honest opinion, even if we don't end up working together."}},"data":{"services":[{"title":"Web development","tagline":"Showcase sites, e-commerce and SaaS platforms","description":"Fast, accessible and scalable web applications. We design experiences that load quickly, rank well and turn your visitors into customers.","deliverables":["Showcase or corporate site","E-commerce store","Web app & SaaS","Migration and redesign"]},{"title":"Mobile apps","tagline":"iOS and Android, native or cross-platform","description":"Mobile apps designed for real-world use: smooth, elegant and stable. From idea to the stores, we support every stage of your app's life cycle.","deliverables":["iOS & Android apps","Startup MVP","Internal apps","Store publication"]},{"title":"UI/UX Design","tagline":"Interfaces people love and use","description":"A great product starts with a great experience. We design clear interfaces, tested with real users, and ship reusable design systems.","deliverables":["Design system","Figma mockups","UX audit","Interactive prototypes"]},{"title":"Backend & Cloud","tagline":"Robust APIs and reliable infrastructure","description":"The submerged part of the iceberg: secure APIs, well-modeled databases, CI/CD and cloud hosting. Everything you need to grow painlessly.","deliverables":["REST & GraphQL APIs","Cloud architecture","CI/CD & DevOps","Monitoring & security"]}],"steps":[{"title":"Discovery","description":"A first conversation to understand your business, your users and your constraints. No jargon, no commitment."},{"title":"Design","description":"Wireframes, mockups and tech stack validated together. You know exactly what will be delivered, and at what price."},{"title":"Development","description":"Two-week sprints with regular demos. You see the product evolve and can adjust course continuously."},{"title":"Launch & support","description":"Go-live, team training and maintenance. We stay by your side after launch."}],"testimonials":[{"quote":"Opexm understood our business in a week. The app shipped on time, with a level of polish we had never seen from a vendor.","author":"Sarah Marchetti","role":"CEO, PayFlow"},{"quote":"Our e-commerce redesign doubled our average cart in three months. Clear communication, fast iterations, zero billing surprises.","author":"Karim Belkacem","role":"Founder, Marché Libre"},{"quote":"They replaced a monstrous Excel tool with a platform the whole team adopted in two days. Master craftsmanship.","author":"Claire Dubois","role":"COO, MediTrack"}],"pricing":[{"name":"Showcase site","price":"from €2,900","description":"To exist online with a fast, polished website.","features":["Custom design (mockups included)","Up to 8 pages","Basic technical SEO","Contact form","Launch & training","3 months of maintenance included"]},{"name":"App Pack","price":"from €14,900","description":"To launch your mobile app or SaaS.","features":["UX research & mockups","iOS + Android app or web app","Backend & APIs included","Store publication","Analytics & tracking","6 months of maintenance included"]},{"name":"Custom","price":"on quote","description":"For ambitious projects with specific requirements.","features":["Scoping & design workshops","Dedicated architecture","Existing integrations","Dedicated project team","SLA & priority support","Continuous evolution"]}],"faq":[{"question":"How much does a website or an app cost?","answer":"A showcase site starts around €2,900, a mobile app beyond €14,900. Every project is unique, so we provide a detailed, no-surprise quote after a free first call."},{"question":"What are your timelines?","answer":"Allow 3 to 6 weeks for a showcase site, and 2 to 4 months for a mobile app or web platform. We deliver in sprints, so you see the product from the first weeks."},{"question":"Do you work with clients outside Paris?","answer":"Yes — we work with clients across France and Europe. Our remote processes (weekly demos, shared project tool) make collaboration smooth, wherever you are."},{"question":"What happens after launch?","answer":"Every project includes a warranty period. After that, our maintenance plans cover updates, security, backups and evolutions. You stay in control of your product."},{"question":"Custom code or no-code?","answer":"We build custom solutions with modern technologies (Next.js, React Native...). That guarantees performance, code ownership and freedom from proprietary platforms. On tight budgets, we can also recommend a suitable no-code solution."}],"projectTypes":["Showcase website","E-commerce","Mobile app","Web platform / SaaS","Redesign / migration","Other"],"budgets":["< €5,000","€5,000 – €15,000","€15,000 – €50,000","> €50,000","Not sure yet"],"projectsText":[{"category":"Fintech · Mobile app","description":"Peer-to-peer payment app with biometric authentication and real-time transaction tracking.","result":"120,000 downloads in the first year"},{"category":"E-commerce · Web","description":"E-commerce platform for local products with instant search, optimized cart and vendor dashboard.","result":"+38% conversion after redesign"},{"category":"Healthcare · SaaS","description":"Pharmacy inventory SaaS: expiry alerts, automatic ordering and healthcare data compliance.","result":"97% fewer stock-outs"},{"category":"Mobility · Hybrid app","description":"Carpooling app dedicated to university campuses: daily rides, seat booking and built-in messaging.","result":"45,000 rides organized in 8 months"},{"category":"Craft · Showcase","description":"Showcase site for a ceramics workshop with immersive gallery, online booking and unique pieces for sale.","result":"Order book full for 6 months"},{"category":"Logistics · B2B platform","description":"Web platform for vehicle fleet management: real-time GPS tracking, predictive maintenance and automated reports.","result":"-30% fleet maintenance costs"}],"stats":[{"value":"30+","label":"Projects delivered"},{"value":"12","label":"Years of experience"},{"value":"98%","label":"Satisfied clients"},{"value":"8","label":"Passionate experts"}]}}}]
