b:["$","$L23",null,{"dict":{"meta":{"title":"أوبكسيم — وكالة تطوير الويب وتطبيقات الجوال","description":"تصمّم أوبكسيم وتبني تطبيقات ويب وجوال مخصصة: مواقع الشركات، المتاجر الإلكترونية، منصات SaaS، تطبيقات iOS و Android."},"header":{"services":"خدماتنا","works":"أعمالنا","contact":"اتصل بنا","startProject":"ابدأ مشروعك","openMenu":"فتح القائمة","closeMenu":"إغلاق القائمة","switchLanguage":"تغيير اللغة"},"footer":{"tagline":"وكالة تطوير ويب وجوال. نحوّل أفكارك إلى منتجات رقمية تدوم طويلاً.","services":"الخدمات","navigation":"التنقل","contact":"التواصل","madeWith":"مبني باستخدام Next.js و Tailwind CSS والكثير من القهوة.","rights":"جميع الحقوق محفوظة.","webDev":"تطوير الويب","mobileApps":"تطبيقات الجوال","uiUx":"تصميم الواجهات","home":"الرئيسية"},"shared":{"more":"اعرف المزيد","allWorks":"استعرض كل أعمالنا","chosen":"الأكثر طلباً","choosePlan":"اختر هذا العرض","faq":"الأسئلة الشائعة"},"home":{"badge":"وكالة ويب وجوال · تونس","heroTitleStart":"نصنع","heroHighlight":"تطبيقات","heroTitleEnd":"يعشقها المستخدمون","heroText":"تصمّم أوبكسيم وتبني مواقع ويب وتطبيقات جوال مخصصة. تصميم متقن، شيفرة عصرية، تسليم عبر دورات عمل: مشروعك يتقدم وأنت تحتفظ بالسيطرة.","heroCta":"ابدأ مشروعك","heroSecondary":"استعرض أعمالنا","servicesEta":"خدماتنا","servicesTitle":"كل ما تحتاجه للنجاح عبر الإنترنت","servicesText":"من أول نموذج تصميم حتى الإطلاق، نغطي دورة حياة منتجك الرقمي بالكامل.","methodEta":"منهجيتنا","methodTitle":"مسار واضح بلا مفاجآت","methodText":"تعرف دائماً أين وصل مشروعك، وما الذي يليه، وكم سيكلفك.","worksEta":"أعمالنا","worksTitle":"مشاريع تصنع الفرق","worksText":"نماذج من منتجات صممناها وطورناها وأطلقناها مع عملائنا.","quotesEta":"شهادات","quotesTitle":"عملاء وثقوا بنا","stackEta":"التقنيات","stackTitle":"تقنيات عصرية مُجرّبة","pricingEta":"الأسعار","pricingTitle":"عروض واضحة تناسب مرحلتك","pricingText":"ميزانية محددة منذ اليوم الأول. بلا تكاليف خفية ولا مفاجآت.","faqTitle":"أسئلتكم، إجاباتنا","contactTitle":"مشروع في بالك؟ لنحادث.","contactText":"نرد خلال 24 ساعة عمل، دون أي التزام.","contactCity":"باريس، فرنسا","contactCta":"ابدأ المحادثة","ctaTitle":"جاهز لإطلاق مشروعك؟","ctaText":"حدثنا عن فكرتك، وسنعود إليك بخطة عمل وتقدير واضح للمجانية.","ctaButton":"اطلب عرض سعر مجاني","stripMessage":"مشروع يدور في ذهنك؟","stripButton":"لنتحدث"},"servicesPage":{"title":"خدماتنا","intro":"أربع خبرات متكاملة لبناء منتجات رقمية كاملة، من التصميم إلى البنية التحتية.","techEta":"التقنيات","techTitle":"صندوق أدواتنا","techText":"نختار التقنية الملائمة لمشروعك، وليس العكس.","ctaTitle":"تحتاج خدمة محددة؟","ctaText":"صف لنا احتياجك، وسنخبرك بأمانة إن كنا الشريك المناسب — وإن لم نكن، فمن يجب أن تتصل به.","ctaButton":"دردش حول هذه الخدمة"},"worksPage":{"title":"أعمالنا","intro":"منتجات رقمية بُنيت مع عملائنا، وتقاس بالأثر الحقيقي الذي أحدثته.","clientsEta":"العملاء","clientsTitle":"ماذا يقولون","ctaTitle":"مشروعك هنا؟","ctaText":"كل خانة في هذه الشبكة بدأت بمحادثة. قد يكون مشروعك التالي."},"contactPage":{"title":"لنحادث عن مشروعك","intro":"صف فكرتك في بضعة أسطر. سنعود إليك بتحليل أولي وموعد، مجاناً.","form":{"name":"الاسم الكامل *","namePlaceholder":"محمد العلي","email":"البريد الإلكتروني *","emailPlaceholder":"mohamed@company.com","company":"الشركة","companyPlaceholder":"شركة محدودة","projectType":"نوع المشروع *","budget":"الميزانية المتوقعة","message":"مشروعك في كلمات قليلة *","messagePlaceholder":"مثال: نريد تطبيق جوال ليتمكن عملاؤنا من حجز خدماتنا عبر الإنترنت...","submit":"أرسل طلبي","sending":"جارٍ الإرسال...","privacy":"بياناتك تبقى سرية ولا تُشارك أبداً."},"success":{"title":"تم إرسال الرسالة!","text":"شكراً لرسالتك. سيتواصل فريقنا معك خلال 24 ساعة عمل لتحديد مكالمة أولى.","again":"أرسل رسالة أخرى"},"aside":{"title":"تواصل مباشر","email":"البريد الإلكتروني","phone":"الهاتف","address":"العنوان","hours":"ساعات العمل","freeTitle":"⚡ مكالمة أولى مجانية","freeText":"30 دقيقة عبر الهاتف أو الفيديو لفهم احتياجك. ستخرج برأي صادق، حتى لو لم نعمل معاً."}},"data":{"services":[{"title":"تطوير الويب","tagline":"مواقع الشركات، المتاجر الإلكترونية ومنصات SaaS","description":"تطبيقات ويب سريعة ومتاحة وقابلة للتوسع. نصمم تجارب تُحمّل سريعاً، وتتصدر محركات البحث، وتحوّل زوارك إلى عملاء.","deliverables":["موقع تعريفي أو مؤسسي","متجر إلكتروني","تطبيق ويب و SaaS","الترحيل وإعادة التصميم"]},{"title":"تطبيقات الجوال","tagline":"iOS و Android، أصلي أو متعدد المنصات","description":"تطبيقات جوال مصممة للاستخدام الواقعي: سلسة وأنيقة ومستقرة. من الفكرة حتى المتاجر، نرافقك في كل مرحلة من دورة حياة تطبيقك.","deliverables":["تطبيقات iOS و Android","MVP للشركات الناشئة","تطبيقات داخلية","النشر على المتاجر"]},{"title":"تصميم الواجهات","tagline":"واجهات محبوبة وفعالة","description":"المنتج الجيد يبدأ بتجربة جيدة. نصمم واجهات واضحة، مختبرة مع مستخدمين حقيقيين، ونسلّم أنظمة تصميم قابلة لإعادة الاستخدام.","deliverables":["نظام تصميم","نماذج Figma","تدقيق تجربة المستخدم","نماذج أولية تفاعلية"]},{"title":"الخوادم والسحابة","tagline":"واجهات برمجية قوية وبنية تحتية موثوقة","description":"الجزء الغائر من جبل الجليد: واجهات برمجية مؤمنة، قواعد بيانات نموذجية جيداً، CI/CD واستضافة سحابية. كل ما تحتاجه للنمو دون ألم.","deliverables":["واجهات REST و GraphQL","بنية سحابية","CI/CD و DevOps","المراقبة والأمن"]}],"steps":[{"title":"الاستكشاف","description":"محادثة أولى لفهم مجال عملك ومستخدميك وقيودك. بلا مصطلحات معقدة وبلا التزام."},{"title":"التصميم","description":"نماذج أولية وتصاميم ومجموعة تقنية تعتمدها معنا. تعرف بدقة ما سيُسلَّم، وبأي سعر."},{"title":"التطوير","description":"دورات عمل من أسبوعين مع عروض دورية. ترى المنتج يتقدم ويمكنك تعديل المسار باستمرار."},{"title":"الإطلاق والمتابعة","description":"الإطلاق، تدريب فرقك، والصيانة. نبقى إلى جانبك بعد النشر."}],"testimonials":[{"quote":"فهمت أوبكسيم مجالنا في أسبوع واحد. خرج التطبيق في الموعد، بمستوى إتقان لم نره من أي مزود من قبل.","author":"سارة ماركيتي","role":"المديرة التنفيذية، PayFlow"},{"quote":"أعاد بناء متجرنا الإلكتروني مضاعفة سلة الشراء الوسطى في ثلاثة أشهر. تواصل واضح، تكرار سريع، صفر مفاجآت في الفواتير.","author":"كريم بلقاسم","role":"المؤسس، Marché Libre"},{"quote":"استبدلوا أداة Excel مرعبة بمنصة تبنّاها الفريق كله في يومين. عمل فنان.","author":"كلير دوبوا","role":"مديرة العمليات، MediTrack"}],"pricing":[{"name":"موقع تعريفي","price":"ابتداءً من 2,900 €","description":"لتتواجد عبر الإنترنت بموقع سريع ومصقول.","features":["تصميم مخصص (تشمل النماذج)","حتى 8 صفحات","تحسين أساسي لمحركات البحث","نموذج اتصال","الإطلاق والتدريب","3 أشهر صيانة مجانية"]},{"name":"حزمة التطبيق","price":"ابتداءً من 14,900 €","description":"لإطلاق تطبيق جوال أو منصة SaaS.","features":["دراسة تجربة المستخدم والنماذج","تطبيق iOS + Android أو تطبيق ويب","الخوادم والواجهات البرمجية مشمولة","النشر على المتاجر","التحليلات والمتابعة","6 أشهر صيانة مجانية"]},{"name":"مخصص","price":"بعرض سعر","description":"للمشاريع الطموحة بمتطلبات خاصة.","features":["تحديد الإطار وورش التصميم","بنية مخصصة","التكامل مع الأنظمة القائمة","فريق مخصص للمشروع","اتفاقية مستوى خدمة ودعم ذو أولوية","تطور مستمر"]}],"faq":[{"question":"كم يكلف موقع أو تطبيق؟","answer":"يبدأ الموقع التعريفي حوالي 2,900 €، وتتجاوز تطبيقات الجوال 14,900 €. كل مشروع فريد، لذا نعد عرض سعر مفصلاً وخالياً من المفاجآت بعد مكالمة أولى مجانية."},{"question":"ما هي آجال تنفيذكم؟","answer":"احسب 3 إلى 6 أسابيع لموقع تعريفي، و2 إلى 4 أشهر لتطبيق جوال أو منصة ويب. نسلم عبر دورات عمل، فترى المنتج منذ الأسابيع الأولى."},{"question":"هل تعملون مع عملاء خارج باريس؟","answer":"نعم، نعمل مع عملاء في كل فرنسا وأوروبا. عملياتنا عن بُعد (عروض أسبوعية، أداة إدارة مشتركة) تجعل التعاون سلساً أينما كنت."},{"question":"ماذا يحدث بعد الإطلاق؟","answer":"كل مشروع يشمل فترة ضمان. بعدها تغطي عروض الصيانة لدينا التحديثات والأمن والنسخ الاحتياطية والتطورات. تبقى أنت سيّد منتجك."},{"question":"شيفرة مخصصة أم منصات جاهزة؟","answer":"نطوّر شيفرة مخصصة بتقنيات عصرية (Next.js، React Native...). هذا يضمن الأداء وملكية الشيفرة والتحرر من المنصات المغلقة. وفي الميزانيات المحدودة نعرف أيضاً أن نوصي بحل جاهز مناسب."}],"projectTypes":["موقع تعريفي","متجر إلكتروني","تطبيق جوال","منصة ويب / SaaS","إعادة تصميم / ترحيل","أخرى"],"budgets":["أقل من 5,000 €","5,000 – 15,000 €","15,000 – 50,000 €","أكثر من 50,000 €","لست متأكداً بعد"],"projectsText":[{"category":"تقنية مالية · تطبيق جوال","description":"تطبيق جوال للدفع بين الأفراد مع مصادقة بيومترية ومتابعة المعاملات في الوقت الحقيقي.","result":"120,000 تحميل في السنة الأولى"},{"category":"تجارة إلكترونية · ويب","description":"منصة تجارة إلكترونية للمنتجات المحلية مع بحث فوري وسلة محسّنة ولوحة تحكم للبائع.","result":"+38% معدل تحويل بعد إعادة التصميم"},{"category":"صحة · SaaS","description":"نظام SaaS لتتبع المخزون في الصيدليات: تنبيهات انتهاء الصلاحية، طلبات آلية والالتزام ببيانات الصحة.","result":"97% تقليص في نفايات المخزون"},{"category":"تنقل · تطبيق هجين","description":"تطبيق مشاركة الركوب مخصص للجامعات: رحلات يومية، حجز مقاعد ورسائل مدمجة.","result":"45,000 رحلة منظمة في 8 أشهر"},{"category":"حرف · موقع تعريفي","description":"موقع تعريفي لورشة خزف مع معرض غامر وحجز مواعيد عبر الإنترنت وبيع قطع فريدة.","result":"دفتر طلبات ممتلئ لمدة 6 أشهر"},{"category":"لوجستيك · منصة B2B","description":"منصة ويب لإدارة أسطول المركبات: تتبع GPS حياً، صيانة تنبؤية وتقارير آلية.","result":"-30% من تكاليف صيانة الأسطول"}],"stats":[{"value":"+60","label":"مشروع منجز"},{"value":"12","label":"سنة خبرة"},{"value":"98%","label":"عملاء راضون"},{"value":"8","label":"خبراء شغوفون"}]}}}]
